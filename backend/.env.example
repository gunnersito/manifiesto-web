# Copia este fichero a backend/.env y rellena los valores para desarrollo local.
# En Render se configuran en el panel (o con el render.yaml de la raíz).
SECRET_KEY=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# Opcional: orígenes permitidos para el frontend, separados por comas.
# CORS_ORIGINS=http://localhost:3000

# Opcional: ruta alternativa para orden-provincias.json.
# ORDEN_PROVINCIAS_PATH=

# Opcional: si defines las dos, la API crea este admin al arrancar (y
# crear_admin.py lo usa en vez de preguntar la contraseña).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
